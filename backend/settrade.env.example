# Settrade Open API v2 credentials for Signalix update_data.py
# Copy these keys into /root/signalix/.env or the systemd/docker environment.
# Do NOT commit real values.

SETTRADE_APP_ID=
SETTRADE_APP_SECRET=
SETTRADE_BROKER_ID=
SETTRADE_APP_CODE=

# Optional knobs
SETTRADE_AUTO_QUEUE=false
SETTRADE_INTERVAL=1d
SETTRADE_NORMALIZED=true
SETTRADE_SLEEP_SECONDS=0.25
SETTRADE_REQUEST_TIMEOUT=35
# Conservative pilot controls. These are operational safeguards, not a claim
# about Settrade's undocumented/plan-specific request quota.
SETTRADE_BATCH_SIZE=10
SETTRADE_BATCH_DELAY_SECONDS=1.0
SETTRADE_BATCH_JITTER_SECONDS=0.25
SETTRADE_SESSION_RETRIES=1
SETTRADE_RETRY_BACKOFF_SECONDS=2.0
