[Unit]
Description=Refresh Signalix marginable-long 60m candles every 30 minutes during SET hours

[Timer]
# Data/evaluation owner: 30-minute cadence; service applies the 10:00–16:45 BKK guard.
OnCalendar=Mon..Fri *-*-* 10:00:00 Asia/Bangkok
OnCalendar=Mon..Fri *-*-* 10:30:00 Asia/Bangkok
OnCalendar=Mon..Fri *-*-* 11:00:00 Asia/Bangkok
OnCalendar=Mon..Fri *-*-* 11:30:00 Asia/Bangkok
OnCalendar=Mon..Fri *-*-* 12:00:00 Asia/Bangkok
OnCalendar=Mon..Fri *-*-* 12:30:00 Asia/Bangkok
OnCalendar=Mon..Fri *-*-* 14:00:00 Asia/Bangkok
OnCalendar=Mon..Fri *-*-* 14:30:00 Asia/Bangkok
OnCalendar=Mon..Fri *-*-* 15:00:00 Asia/Bangkok
OnCalendar=Mon..Fri *-*-* 15:30:00 Asia/Bangkok
OnCalendar=Mon..Fri *-*-* 16:00:00 Asia/Bangkok
OnCalendar=Mon..Fri *-*-* 16:30:00 Asia/Bangkok
OnCalendar=Mon..Fri *-*-* 16:45:00 Asia/Bangkok
Persistent=true
Unit=signalix-intraday.service

[Install]
WantedBy=timers.target
