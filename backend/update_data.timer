# Signalix daily EOD updater — systemd timer
# Install: see header of update_data.service
# Fires every weekday at 17:00 Asia/Bangkok (after the SET session completes).

[Unit]
Description=Run Signalix SET EOD update daily

[Timer]
OnCalendar=Mon..Fri 17:00 Asia/Bangkok
Persistent=true
RandomizedDelaySec=300
Unit=signalix-update.service

[Install]
WantedBy=timers.target
