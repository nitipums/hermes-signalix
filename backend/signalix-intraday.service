[Unit]
Description=Signalix tiered shortlist 60m refresh (Settrade, no agent)
After=docker.service network-online.target
Requires=docker.service

[Service]
Type=oneshot
WorkingDirectory=/root/signalix/backend
Environment=POSTGRES_HOST=127.0.0.1
Environment=POSTGRES_PORT=5432
Environment=POSTGRES_USER=signalix
Environment=POSTGRES_PASSWORD=signalix_pass
Environment=POSTGRES_DB=signalix
EnvironmentFile=/root/signalix/settradeupdated.env
# Current/open 60m candle is retained and refreshed during continuous SET sessions.
ExecStart=/bin/bash -lc 't=$(TZ=Asia/Bangkok date +%%H%%M); if { [ "$t" -ge 1015 ] && [ "$t" -le 1230 ]; } || { [ "$t" -ge 1445 ] && [ "$t" -le 1630 ]; }; then exec /root/.venv_img/bin/python /root/signalix/backend/update_data.py --source settrade --intraday-only --intraday-mode tiered --intraday-interval 60m --intraday-limit 2 --no-scan; else echo "signalix tiered 60m: outside SET continuous session ($t Bangkok), skip"; fi'
StandardOutput=append:/root/signalix/intraday_update_log.txt
StandardError=append:/root/signalix/intraday_update_log.txt
TimeoutStartSec=900
# ExecStopPost runs after both successful and failed fetches, so stored candles are
# still evaluated when Settrade/session acquisition fails.
ExecStopPost=/bin/bash -lc 'POSTGRES_HOST=127.0.0.1 POSTGRES_PORT=5432 POSTGRES_USER=signalix POSTGRES_PASSWORD=signalix_pass POSTGRES_DB=signalix /root/.venv_img/bin/python /root/signalix/backend/run_intraday_evaluation.py --mode active --interval 60m'
